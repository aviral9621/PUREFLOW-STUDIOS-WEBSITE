# PureFlow Studios website — environment variables for Vercel
# Vercel → project → Settings → Environment Variables → "Import .env" (or paste) → tick Production + Preview → Save → Redeploy.
# Fill the empty values. Never commit this file to GitHub.

# ── Google Maps (homepage map; browser key, restrict it to pureflowstudios.in + Maps JavaScript API in Google Cloud)
VITE_GOOGLE_MAPS_API_KEY=

# ── Resend (booking emails) — Resend → API Keys → Create → "Sending access", domain pureflowstudios.in
RESEND_API_KEY=
BOOKING_FROM=PureFlow Studios <bookings@pureflowstudios.in>
BOOKING_REPLY_TO=contact@pureflowstudios.in
BOOKING_NOTIFY_EMAIL=contact@pureflowstudios.in

# ── Google Calendar (creates the call + Google Meet link) — from Google Cloud OAuth client + OAuth Playground refresh token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# the Gmail address whose calendar the calls go on (its primary calendar)
GOOGLE_CALENDAR_ID=
BOOKING_TIMEZONE=Asia/Kolkata

# ── Supabase (lead storage) — optional: the site has built-in fallback values; fill only if you move projects
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
